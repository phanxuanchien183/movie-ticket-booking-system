# CineTicket Pro - Environment Configuration

# Next.js Port
PORT=3000

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DATABASE=ticket_booking

# Redis Configuration (High-Concurrency Seat Locking)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Note: If MySQL and Redis are not running, the application will automatically
# activate the embedded in-memory database and lock engine for zero-friction development!
